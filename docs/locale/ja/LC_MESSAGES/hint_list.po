#: ../../hint_list.md:2 e792c703c8f142d0b78b38f98e513671
msgid "Hint list"
msgstr "ヒント一覧"

#: ../../hint_list.md:4 10d0b4858b1c4829ab8218b5a7518154
msgid "The available hints are listed below."
msgstr "使用可能なヒントは以下の通りです。"

#: ../../hint_list.md 6df8ca86b9654dad94e8a66c9a759a05
msgid "Group"
msgstr "グループ"

#: ../../hint_list.md e67da637a9fa40889dfcb2293d1a1518
msgid "Format"
msgstr "書式"

#: ../../hint_list.md 76d3eb63b21d449cb3d01547737860a8
msgid "Description"
msgstr "説明"

#: ../../hint_list.md 8107f2d847684d669fb7724ceb0cb3fc
msgid "Scan method"
msgstr "スキャン方法"

#: ../../hint_list.md 04d2808a73cd4c5481df4162ad48cf2b
msgid "`SeqScan(table)`"
msgstr "`SeqScan(テーブル)`"

#: ../../hint_list.md ac90b6000b504bcdac95cc1dbc5dbb05
msgid "Forces sequential scan on the table."
msgstr "指定されたテーブルにシーケンシャルスキャンを強制します。"

#: ../../hint_list.md ba7ef63ade4a4f07adf20b0d9203be99
msgid "`TidScan(table)`"
msgstr "`TidScan(テーブル)`"

#: ../../hint_list.md 264f7d2668d14526af77fabe5ae610a0
msgid "Forces TID scan on the table."
msgstr "指定されたテーブルにTid スキャンを強制します。検索条件にctidを指定した場合にのみ有効です。"

#: ../../hint_list.md 1b5af0485f484ce7a1c475e47debad6f
msgid "`IndexScan(table[ index...])`"
msgstr "`IndexScan(テーブル[ インデックス...])`"

#: ../../hint_list.md cec4e37d423a4312bb4f0ad18e4d83b9
msgid "Forces index scan on the table.  Restricts to specified indexes if any."
msgstr "指定されたテーブルにインデックススキャンを強制します。指定されたインデックスがある場合は、そのインデックスに限定されます。"

#: ../../hint_list.md 5fdb71b997754cf0967e87bd934b6a6f
msgid "`IndexOnlyScan(table[ index...])`"
msgstr "`IndexOnlyScan(テーブル[ インデックス...])`"

#: ../../hint_list.md 80ca36eeaa01497b81a4cc98a62e28c9
msgid "Forces index-only scan on the table.  Restricts to specified indexes if any.  Index scan may be used if index-only scan is not available."
msgstr ""
"指定されたテーブルにインデックスオンリースキャンを強制します。指定されたインデックスがある場合は、そのインデックスに限定されます。インデックスオンリースキャンが利用できない場合、イン"
"デックススキャンが使用されることがあります。"

#: ../../hint_list.md 415b71827cbd4578a346cc77c0fc80e7
msgid "`BitmapScan(table[ index...])`"
msgstr "`BitmapScan(テーブル[ インデックス...])`"

#: ../../hint_list.md dc13af6f1e3e4f638d86799daee0a8e5
msgid "Forces bitmap scan on the table.  Restricts to specified indexes if any."
msgstr "指定されたテーブルにビットマップスキャンを強制します。指定されたインデックスがある場合は、そのインデックスに限定されます。"

#: ../../hint_list.md 28ac75f1a1904218981288e5f84fafb8
msgid "`IndexScanRegexp(table[ POSIX Regexp...])`<br>`IndexOnlyScanRegexp(table[ POSIX Regexp...])`<br>`BitmapScanRegexp(table[ POSIX Regexp...])`"
msgstr "`IndexScanRegexp(テーブル[ POSIX正規表現...])`<br>`IndexOnlyScanRegexp(テーブル[ POSIX正規表現...])`<br>`BitmapScanRegexp(テーブル[ POSIX正規表現...])`"

#: ../../hint_list.md b79b54f13b4e40c2a2c22de0d07cb006
msgid "Forces index scan, index-only scan or bitmap scan on the table.  Restricts to indexes that matches the specified POSIX regular expression pattern."
msgstr ""
"指定されたテーブルにインデックススキャン、インデックスオンリースキャン（PostgreSQL 9.2以降）、ビットマップスキャンを強制します。指定されたPOSIX正規表現パターンに一致するインデックスに"
"限定されます。"

#: ../../hint_list.md 9768640836a941048b488960e7670718
msgid "`NoSeqScan(table)`"
msgstr "`NoSeqScan(テーブル)`"

#: ../../hint_list.md 936ea6bb48004dd09612e75bf5ba5fbf
msgid "Forces to *not* do sequential scan on the table."
msgstr "指定されたテーブルにシーケンシャルスキャンを行わないように強制します。"

#: ../../hint_list.md 69d22a5fd4e74492bc2b46fb438c2cee
msgid "`NoTidScan(table)`"
msgstr "`NoTidScan(テーブル)`"

#: ../../hint_list.md 2f0a6507698a4fc7a6e81a432f6b80f3
msgid "Forces to *not* do TID scan on the table."
msgstr "指定されたテーブルにTIDスキャンを行わないように強制します。"

#: ../../hint_list.md 078209488f014925b5e3917bd1660868
msgid "`NoIndexScan(table)`"
msgstr "`NoIndexScan(テーブル)`"

#: ../../hint_list.md 5c296351d67c4a63ba0989c4aa167e8a
msgid "Forces to *not* do index scan and index-only scan on the table."
msgstr "指定されたテーブルに対してインデックススキャン、インデックスオンリースキャンを行わないように強制します。"

#: ../../hint_list.md 4eb93ca43c1747d5bc03aa6643f1b56d
msgid "`NoIndexOnlyScan(table)`"
msgstr "`NoIndexOnlyScan(テーブル)`"

#: ../../hint_list.md 16158904d2024523abc54b4af080bf9d
msgid "Forces to *not* do index only scan on the table."
msgstr "指定されたテーブルにTIDスキャンを行わないように強制します。"

#: ../../hint_list.md 78b5deec4f264ab2abeedecfee4e3d7b
msgid "`NoBitmapScan(table)`"
msgstr "`NoBitmapScan(テーブル)`"

#: ../../hint_list.md 10924cf724e14269af2f17b3e8cf5ee5
msgid "Forces to *not* do bitmap scan on the table."
msgstr "指定されたテーブルにビットマップスキャンを行わないように強制します。"

#: ../../hint_list.md 0b9b6e5ce0734d4f8564202a41db383f
msgid "Disable indexes"
msgstr "インデックスの無効化"

#: ../../hint_list.md c0e141c800894881a10904007ba3ab27
msgid "`DisableIndex(table index...)`"
msgstr "`DisableIndex(テーブル[ インデックス...])`"

#: ../../hint_list.md 5216c9bda86e4a2b89a3927f5108d45f
msgid "Disables the specified indexes during query planning, taking precedence over any other hints."
msgstr "指定されたインデックスの使用を無効にします。他のヒントよりも優先されます。"

#: ../../hint_list.md c96e2f5c5c30473e9675b34317e794fe
msgid "Join method"
msgstr "結合方法"

#: ../../hint_list.md 260ffceebb604602836cf4f0d81dee8c
msgid "`NestLoop(table table[ table...])`"
msgstr "`NestLoop(テーブル テーブル[ テーブル...])`"

#: ../../hint_list.md 4a00f737d0e34fdfb3283110364fa6b8
msgid "Forces nested loop for the joins on the tables specified."
msgstr "指定されたテーブルで構成された結合にネステッドループ結合を強制します。"

#: ../../hint_list.md 5a03b51ac3704b99bbac0f9f4f82b371
msgid "`HashJoin(table table[ table...])`"
msgstr "`HashJoin(テーブル テーブル[ テーブル...])`"

#: ../../hint_list.md 374f59ea41c3432b92a852abd01f1529
msgid "Forces hash join for the joins on the tables specified."
msgstr "指定されたテーブルで構成された結合にハッシュ結合を強制します。"

#: ../../hint_list.md 5f8b9bc591b2495a89cae8631b32669e
msgid "`MergeJoin(table table[ table...])`"
msgstr "`MergeJoin(テーブル テーブル[ テーブル...])`"

#: ../../hint_list.md 50863a657fac4b91b4bd3e68597b4f6b
msgid "Forces merge join for the joins on the tables specified."
msgstr "指定されたテーブルで構成された結合にマージ結合を強制します。"

#: ../../hint_list.md 49ce1d0c98ab4c47ae81322830d0119f
msgid "`NoNestLoop(table table[ table...])`"
msgstr "`NoNestLoop(テーブル テーブル[ テーブル...])`"

#: ../../hint_list.md 70ebe829c0a44571a2baff6d2647ab99
msgid "Forces to *not* do nested loop for the joins on the tables specified."
msgstr "指定されたテーブルで構成する結合にネステッドループ結合が行われないように強制します。"

#: ../../hint_list.md 64265c8d97d84daeb0da22f975073a8f
msgid "`NoHashJoin(table table[ table...])`"
msgstr "`NoHashJoin(テーブル テーブル[ テーブル...])`"

#: ../../hint_list.md 0fcb9f2bd63a43a5bd874b8661fd0b25
msgid "Forces to *not* do hash join for the joins on the tables specified."
msgstr "指定されたテーブルで構成する結合にハッシュ結合が行われないように強制します。"

#: ../../hint_list.md d6dbef962cf04799a3d941948b917b47
msgid "`NoMergeJoin(table table[ table...])`"
msgstr "`NoMergeJoin(テーブル テーブル[ テーブル...])`"

#: ../../hint_list.md 46659ff3c61b4ffeb035b842d7667d61
msgid "Forces to *not* do merge join for the joins on the tables specified."
msgstr "指定されたテーブルで構成する結合にマージ結合が行われないように強制します。"

#: ../../hint_list.md 5dfda32920b445ed8f719b2040c97d9c
msgid "Join order"
msgstr "結合順序"

#: ../../hint_list.md adb03e789d024943bd6c5ecd7ef33386
msgid "`Leading(table table[ table...])`"
msgstr "`Leading(テーブル テーブル[ テーブル...])`"

#: ../../hint_list.md 311f508abdcb4196aa09d52bbbbed7c6
msgid "Forces join order as specified."
msgstr "指定された結合順序に強制します。"

#: ../../hint_list.md 069a4fd44dab4246811680ec598ca63f
msgid "`Leading(<join pair>)`"
msgstr "`Leading(<結合のペア>)`"

#: ../../hint_list.md a5a2fb0b4bd94d7db8266bc1bac661d0
msgid "Forces join order and directions as specified.  A join pair is a pair of tables and/or other join pairs enclosed by parentheses, which can make a nested structure."
msgstr "指定された結合順序と方向を強制します。結合ペアは、括弧で囲まれたテーブルや他の結合ペアのペアであり、入れ子構造を作ることができます。"

#: ../../hint_list.md ea745025e1b04208ad0a04b7689b4f46
msgid "Behavior control on Join"
msgstr "結合時の挙動制御"

#: ../../hint_list.md 4317942701fa447e8af265027b21c36c
msgid "`Memoize(table table[ table...])`"
msgstr "`Memoize(テーブル テーブル[ テーブル...])`"

#: ../../hint_list.md b9e66fd8c7fd48f7a0d51217711e8208
msgid "Allows the topmost join of a join among the specified tables to Memoize the inner result. Not enforced."
msgstr "指定されたテーブル間の結合の最上位の結合において内部表の結果をメモすることを許可する (これは強制ではないことに注意)。"

#: ../../hint_list.md 22c24eb4293f420f8f70b3e4eac89d81
msgid "`NoMemoize(table table[ table...])`"
msgstr "`NoMemoize(テーブル テーブル[ テーブル...])`"

#: ../../hint_list.md 9479c008ce3d4b9c9bff943d442a9ce2
msgid "Inhibits the topmost join of a join among the specified tables from Memoizing the inner result."
msgstr "指定されたテーブル間の結合の最上位の結合において内部表の結果をメモすることを禁止します。"

#: ../../hint_list.md 690e25327812402d8d11c82cf2e0d43e
msgid "Row number correction"
msgstr "見積り行数の補正"

#: ../../hint_list.md fd44525a948d4a079fda665309c8fa98
msgid "`Rows(table table[ table...] correction)`"
msgstr "`Rows(テーブル テーブル[ テーブル...] 行数補正)`"

#: ../../hint_list.md 68c1f2e024114b4d8941d66bab770dc9
msgid ""
"Corrects row number of a result of the joins on the tables specified.  The available correction methods are absolute (#<n>), addition (+<n>), subtract (-<n>) and multiplication "
"(*<n>).  <n> should be a string that strtod() can understand."
msgstr "指定されたテーブルの結合結果の見積り行数を補正します。補正方法は、絶対値(#<n>)、加算(+<n>)、減算(-<n>)、乗算(*<n>)です。<n>はstrtod()が読み込める文字列でなければなりません。"

#: ../../hint_list.md 685db9e62d6346f6bfeb3f14cc15a01b
msgid "Parallel query configuration"
msgstr "パラレルクエリの設定"

#: ../../hint_list.md 7a875c577af74064a43c82b188f5f077
msgid "`Parallel(table <# of workers> [soft|hard])`"
msgstr "`Parallel(table <ワーカー数> [soft|hard])`"

#: ../../hint_list.md e3df1a9d90084ca8ae715daa6273f0ca
msgid ""
"Enforces or inhibits parallel execution of the specified table.  <# of workers> is the desired number of parallel workers, where zero means inhibiting parallel execution.  If the "
"third parameter is soft (default), it suggests the number of workers but lets the planner decide whether parallel is worthwhile based on cost.  Hard forces parallel execution "
"regardless of cost estimates by penalizing non-parallel paths."
msgstr ""
"指定されたテーブルの並列実行を強制または禁止します。<ワーカー数>は希望する並列ワーカー数で、0は並列実行を禁止することを意味します。第3パラメータがsoft（デフォルト）の場合、ワーカー数を"
"提示しますが、並列実行を行う価値があるかどうかはコストに基づいてプランナが判断します。「hard」を指定すると、非並列実行のパスにペナルティを課すことで、コスト見積もりに関係なく並列実行が"
"強制されます。"

#: ../../hint_list.md 5d8df97dce5f422d8de1f038469160f7
msgid "GUC"
msgstr "GUCパラメータ"

#: ../../hint_list.md 10733734024440fbbbd55bd4e3033bfa
msgid "`Set(GUC-param value)`"
msgstr "`Set(GUCパラメータ 値)`"

#: ../../hint_list.md e9762a271a064789bb3069e1c163d639
msgid "Sets GUC parameter to the value defined while planner is running."
msgstr "プランナが実行中の間、GUCパラメータの値を設定します。"

